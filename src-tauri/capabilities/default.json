{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands, library-changed events, folder/file pickers, close guard, title-bar dragging",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
